    "ios_app_pip_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the script in a small window that stays on top when you switch to another app. It is experimental: iOS decides the size and position of the window, and another app that is recording may stop Suflyor from hearing you."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o roteiro numa janela pequena que fica por cima quando você troca de app. É experimental: o iOS decide o tamanho e a posição da janela, e outro app que esteja gravando pode impedir o Suflyor de ouvir você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает текст в маленьком окне, которое остаётся поверх других приложений. Это экспериментальная функция: размер и положение окна выбирает iOS, а другое приложение, которое ведёт запись, может лишить Suflyor доступа к микрофону."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni, başka bir uygulamaya geçtiğinizde üstte kalan küçük bir pencerede gösterir. Deneyseldir: pencerenin boyutunu ve konumunu iOS belirler, kayıt yapan başka bir uygulama Suflyor'un sizi duymasını engelleyebilir."
          }
        }
      }
    },
    "ios_app_pip_limits" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the other app takes the microphone, the text keeps scrolling by itself at your speed. To follow your voice for sure, record with Suflyor's own camera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o outro app ocupar o microfone, o texto continua rolando sozinho na sua velocidade. Para seguir sua voz com certeza, grave com a câmera do próprio Suflyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если другое приложение займёт микрофон, текст продолжит прокручиваться сам с заданной скоростью. Чтобы текст точно шёл за голосом, записывайте на камеру самого Suflyor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer uygulama mikrofonu alırsa metin, ayarladığınız hızda kendi kendine kaymaya devam eder. Sesinizi kesin takip etmesi için Suflyor'un kendi kamerasıyla kaydedin."
          }
        }
      }
    },
