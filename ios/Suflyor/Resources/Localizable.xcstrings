    "ios_app_privacy_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suflyor has no network code: it doesn't connect to the internet, has no accounts, no analytics and no ads."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Suflyor não tem código de rede: não se conecta à internet, não tem contas, análises nem anúncios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Suflyor нет сетевого кода: приложение не выходит в интернет, в нём нет учётных записей, аналитики и рекламы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suflyor'da ağ kodu yok: internete bağlanmaz; hesap, analiz ve reklam içermez."
          }
        }
      }
    },
    "ios_app_privacy_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your voice is recognized on this iPhone. Audio and recognized text are never stored or sent anywhere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua voz é reconhecida neste iPhone. O áudio e o texto reconhecido nunca são guardados nem enviados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос распознаётся на этом iPhone. Звук и распознанный текст нигде не сохраняются и никуда не отправляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiniz bu iPhone'da tanınır. Ses ve tanınan metin hiçbir yerde saklanmaz veya gönderilmez."
          }
        }
      }
    },
    "ios_app_privacy_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts and settings stay on this iPhone. Videos you record are saved to your photo library only when you choose to."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roteiros e ajustes ficam neste iPhone. Os vídeos gravados só vão para a sua galeria quando você escolhe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тексты и настройки остаются на этом iPhone. Записанные видео попадают в медиатеку, только если вы это выберете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metinler ve ayarlar bu iPhone'da kalır. Kaydettiğiniz videolar yalnızca siz seçerseniz fotoğraf kitaplığına kaydedilir."
          }
        }
      }
    },
    "ios_app_privacy_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The log in Settings stays on the phone; you decide whether to share it. Speech packs are downloaded by your browser, not by the app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro nos Ajustes fica no aparelho; você decide se o compartilha. Os pacotes de voz são baixados pelo seu navegador, não pelo app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал в настройках остаётся на телефоне; делиться им или нет — решаете вы. Языковые пакеты скачивает ваш браузер, а не приложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlardaki günlük telefonda kalır; paylaşıp paylaşmamaya siz karar verirsiniz. Konuşma paketlerini uygulama değil tarayıcınız indirir."
          }
        }
      }
    },
