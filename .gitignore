# Gradle, Kotlin, IDE
.gradle/
.kotlin/
build/
captures/
.idea/
*.iml
.DS_Store

# Machine-specific paths (sdk.dir, jdk.dir)
local.properties

# Downloaded by the fetchSpeechAssets task (see app/build.gradle.kts) and checked by SHA-256
app/libs/*.aar
app/src/main/assets/asr-ru/*.onnx
app/src/main/assets/asr-ru/tokens.txt
app/src/main/assets/asr-ru/bpe.vocab
app/src/main/assets/asr-en/*.onnx
app/src/main/assets/asr-en/tokens.txt
app/src/main/assets/asr-en/bpe.vocab
app/src/main/assets/asr-tr/*.onnx
app/src/main/assets/asr-tr/tokens.txt
*.part

# iOS "full" build models, downloaded by ios/scripts/fetch-speech-models.sh
ios/Suflyor/Models/

# Signing keys and their passwords
*.jks
*.keystore
keystore.properties

# Built apps
*.apk
*.aab

# Python bytecode from tools/
__pycache__/

# iOS: sherpa-onnx / ONNX Runtime xcframeworks fetched by ios/scripts/fetch-sherpa-onnx.sh (SHA-256 pinned)
ios/Packages/SuflyorKit/Vendor/*.xcframework
ios/Packages/SuflyorKit/Vendor/.sherpa-onnx-installed
